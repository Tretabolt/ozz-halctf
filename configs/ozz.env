# Ozz Configuration
# Copy to /config/ozz.env and modify as needed

# Model configuration
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct
MODEL_PATH=/models
VLLM_PORT=8000
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=1

# Agent configuration
MAX_TOKENS=4096
TEMPERATURE=0.3
MAX_ITERATIONS=200

# Targets (comma-separated)
TARGETS=10.0.0.1

# Logging
LOG_LEVEL=INFO
